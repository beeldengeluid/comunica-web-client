# List NISV items published on Peertube channel 'ons_land' (strictly playable for Onsland).
# Datasource: https://cat.apis.beeldengeluid.nl/sparql
PREFIX sdo: <https://schema.org/>

SELECT ?s ?title ?peertube_url ?license
WHERE {
  ?s sdo:name ?title ;
     sdo:mainEntityOfPage ?peertube_url .
  ?peertube_url sdo:conditionsOfAccess "Media is published in Peertube channel 'ons_land' with privacy setting 'Password_protected'."@en ;
                sdo:license ?license .
}
