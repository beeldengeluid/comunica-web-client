# List items published on Peertube only available for Onsland
# Datasource: https://cat.apis.beeldengeluid.nl/sparql
PREFIX sdo: <https://schema.org/>

# Items with an associated MediaObject on Peertube and strictly playable for Onsland.
SELECT ?s ?title ?peertube_url ?license
WHERE {
  ?s sdo:name ?title ;
     sdo:associatedMedia ?peertube_url .
     ?peertube_url sdo:conditionsOfAccess "Media is password protected and only available for Onsland."@en .
     ?peertube_url sdo:license ?license .
} 
