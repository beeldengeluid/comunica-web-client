# List identifiers for B&G catalogue items published on Open Beelden/Open Images
# Datasource: https://cat.apis.beeldengeluid.nl/sparql
PREFIX sdo: <https://schema.org/>
SELECT DISTINCT ?s
WHERE {
  ?s sdo:mainEntityOfPage ?open_beelden_url .
  FILTER(STRSTARTS(STR(?open_beelden_url), "https://www.openbeelden.nl/media/"))
}