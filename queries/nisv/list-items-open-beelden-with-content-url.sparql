# List NISV cat items published on "Open Beelden" (OpenImages)
# Datasource: https://cat.apis.beeldengeluid.nl/sparql
PREFIX sdo: <https://schema.org/>

# Show identifier and content URL for items that are published on Open Images
SELECT ?s ?title ?open_beelden_url ?content_url ?encoding
WHERE {
  ?s sdo:name ?title ;
     sdo:associatedMedia ?open_beelden_url .
  FILTER(STRSTARTS(STR(?open_beelden_url), "https://www.openbeelden.nl/media/"))
  ?open_beelden_url sdo:encodingFormat ?encoding ;
      sdo:contentUrl ?content_url
}