# List NISV cat items (published on Peertube)
# Datasource: https://cat.apis.beeldengeluid.nl/sparql
PREFIX sdo: <https://schema.org/>

# Items with an associated WebPage on Peertube
SELECT ?s ?title ?peertube_url ?license
WHERE {
  ?s sdo:name ?title ;
     sdo:mainEntityOfPage ?peertube_url .
  ?peertube_url sdo:license ?license .
  FILTER(STRSTARTS(STR(?peertube_url), "https://peertube.beeldengeluid.nl/videos/watch/"))
}
